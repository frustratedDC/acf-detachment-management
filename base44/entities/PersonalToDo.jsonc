{
  "name": "PersonalToDo",
  "type": "object",
  "properties": {
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "string"
    },
    "Priority": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "Status": {
      "type": "string",
      "enum": [
        "Open",
        "Done"
      ],
      "default": "Open"
    },
    "OwnerPNumber": {
      "type": "string"
    }
  },
  "required": [
    "Title",
    "OwnerPNumber"
  ]
}
