{
  "name": "EventLessonStores",
  "type": "object",
  "properties": {
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID"
    },
    "StanceID": {
      "type": "string",
      "description": "Linked EventTrainingStance ID"
    },
    "LessonCode": {
      "type": "string",
      "description": "SyllabusMaster LessonCode this stores entry applies to"
    },
    "Location": {
      "type": "string",
      "description": "Where the lesson is delivered"
    },
    "Notes": {
      "type": "string"
    },
    "Welfare": {
      "type": "string",
      "description": "Welfare requirements e.g. Water"
    },
    "Dress": {
      "type": "string",
      "description": "Dress state for the lesson"
    },
    "StoresRequest": {
      "type": "string",
      "description": "Stores requested from CQMS / stores section"
    },
    "OwnStores": {
      "type": "string",
      "description": "Stores cadets bring themselves"
    },
    "DetachmentID": {
      "type": "string"
    }
  },
  "required": [
    "EventID",
    "LessonCode",
    "DetachmentID"
  ]
}
