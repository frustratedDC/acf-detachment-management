{
  "name": "KASession",
  "type": "object",
  "properties": {
    "SessionID": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "Date": {
      "type": "string",
      "format": "date",
      "description": "Date of the fitness session"
    },
    "StartTime": {
      "type": "string",
      "description": "Session start time (HH:MM format)"
    },
    "EndTime": {
      "type": "string",
      "description": "Session end time (HH:MM format)"
    },
    "DurationMinutes": {
      "type": "number",
      "description": "Total session duration in minutes"
    },
    "AssignedStarLevels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Star levels assigned to this session"
    },
    "Attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of attendee PNumbers (from nominal roll)"
    },
    "AdHocAttendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "PNumber": {
            "type": "string"
          }
        }
      },
      "description": "Ad-hoc attendees added directly to this session, not on the event nominal roll"
    },
    "Scores": {
      "type": "object",
      "description": "Key-value map of PNumber to activity score subsets",
      "additionalProperties": true
    },
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID when this session runs during an event"
    },
    "StanceID": {
      "type": "string",
      "description": "Linked EventTrainingStance ID when this session runs against a stance cadet subset"
    }
  },
  "required": [
    "Date",
    "StartTime"
  ]
}