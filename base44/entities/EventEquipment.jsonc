{
  "name": "EventEquipment",
  "type": "object",
  "properties": {
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID"
    },
    "ItemName": {
      "type": "string"
    },
    "Quantity": {
      "type": "number",
      "default": 1
    },
    "Size": {
      "type": "string"
    },
    "Source": {
      "type": "string",
      "enum": [
        "CQMS Provided",
        "Own Provision"
      ]
    },
    "DetachmentID": {
      "type": "string"
    }
  },
  "required": [
    "EventID",
    "ItemName",
    "DetachmentID"
  ]
}
