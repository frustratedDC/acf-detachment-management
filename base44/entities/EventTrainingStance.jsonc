{
  "name": "EventTrainingStance",
  "type": "object",
  "properties": {
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID"
    },
    "StanceLabel": {
      "type": "string",
      "description": "Rotation label e.g. A1, B2, C1, D2"
    },
    "StartTime": {
      "type": "string",
      "format": "date-time",
      "description": "Stance start date and time"
    },
    "EndTime": {
      "type": "string",
      "format": "date-time",
      "description": "Stance end date and time"
    },
    "SubjectName": {
      "type": "string",
      "description": "Legacy single subject (kept for backward-compat reads). Prefer SubjectNames."
    },
    "SubjectNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple subjects taught in this stance, from SyllabusMaster"
    },
    "LessonCodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SyllabusMaster LessonCodes taught in this stance"
    },
    "StaffIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "EventStaff record IDs assigned to instruct this stance"
    },
    "CadetIDs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "EventNominalRoll record IDs assigned to this stance rotation"
    },
    "SortOrder": {
      "type": "number",
      "default": 0,
      "description": "Display/order order for the stance in the plan timeline"
    },
    "DetachmentID": {
      "type": "string"
    }
  },
  "required": [
    "EventID",
    "StanceLabel",
    "DetachmentID"
  ]
}