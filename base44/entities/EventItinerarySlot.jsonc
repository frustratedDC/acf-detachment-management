{
  "name": "EventItinerarySlot",
  "type": "object",
  "properties": {
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID"
    },
    "StartTime": {
      "type": "string",
      "format": "date-time"
    },
    "DurationMinutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "SlotType": {
      "type": "string",
      "enum": [
        "BREAKFAST",
        "LUNCH",
        "EVENING MEAL",
        "BREAK",
        "OTHER"
      ]
    },
    "Label": {
      "type": "string",
      "description": "Optional label/description"
    },
    "DetachmentID": {
      "type": "string"
    }
  },
  "required": [
    "EventID",
    "StartTime",
    "DurationMinutes",
    "SlotType",
    "DetachmentID"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.AccessLevel": 6
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.AccessLevel": 5
              }
            },
            {
              "data.DetachmentID": "{{user.data.DetachmentID}}"
            }
          ]
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.AccessLevel": 6
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.AccessLevel": 5
              }
            },
            {
              "data.DetachmentID": "{{user.data.DetachmentID}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.AccessLevel": 6
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.AccessLevel": 5
              }
            },
            {
              "data.DetachmentID": "{{user.data.DetachmentID}}"
            }
          ]
        }
      ]
    }
  }
}