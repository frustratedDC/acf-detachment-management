{
  "name": "EventItinerarySlot",
  "type": "object",
  "properties": {
    "EventID": {
      "type": "string",
      "description": "Linked EventTrainingPlan ID"
    },
    "StartTime": {
      "type": "string",
      "format": "date-time"
    },
    "DurationMinutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "SlotType": {
      "type": "string",
      "enum": [
        "BREAKFAST",
        "LUNCH",
        "EVENING MEAL",
        "BREAK",
        "OTHER"
      ]
    },
    "Label": {
      "type": "string",
      "description": "Optional label/description"
    },
    "DetachmentID": {
      "type": "string"
    }
  },
  "required": [
    "EventID",
    "StartTime",
    "DurationMinutes",
    "SlotType",
    "DetachmentID"
  ]
}
