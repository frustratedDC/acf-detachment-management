{
  "name": "Promotion Readiness Check",
  "description": "Checks whether a cadet has reached promotion readiness after a progress entry is approved, and creates a PromotionMilestoneTask for DC/2IC sign-off.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"Status\") != null) and (.trigger.data.Status == \"Approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProgressLedger"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "promotion_readiness_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkPromotionReadiness",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkPromotionReadiness"
  }
}